# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Milvus ────────────────────────────────────────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=                # leave blank for open Milvus; set for Zilliz Cloud

# ─── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=ntcir-media

# ─── Redis (ARQ task queue) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=                    # required for gated CASTLE2024 dataset

# ─── Model Paths / Devices ─────────────────────────────────────────────────────
DEVICE=cuda                  # cpu | cuda | mps
WHISPER_MODEL=large-v3
CLAP_MODEL=laion/clap-htsat-fused
CLIP_MODEL=ViT-L-14
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TEXT_ENCODER_MODEL=sentence-transformers/all-mpnet-base-v2
MODEL_CACHE_DIR=./model_cache

# ─── LLM Reasoning (WorldMM Agent) ────────────────────────────────────────────
OPENAI_API_KEY=
LLM_PROVIDER=openai           # openai | ollama | none
LLM_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
